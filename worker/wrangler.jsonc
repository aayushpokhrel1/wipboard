{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wipboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "vars": {
    // "token" (the safe default) makes the Worker guard the board itself with a
    // VIEW_TOKEN cookie. "access" turns that off and trusts something upstream,
    // which is only correct if you have actually put Cloudflare Access, or an
    // equivalent, in front of this hostname. Nothing here verifies that you did.
    //
    // "access" since 2026-11-08. Cloudflare Access covers this hostname, and
    // stacking the Worker's own cookie behind it bought nothing: the second
    // gate answered a bare 401 to a reader Access had already identified, and
    // it had to be cleared once per browser, which is hostile on the phone this
    // board is read on. Two preconditions make this safe and both are checked
    // above and below: "workers_dev" is false, so there is no unprotected copy
    // on workers.dev, and the only route is the hostname Access guards. Flip
    // this back to "token" the moment either stops being true.
    "AUTH_MODE": "access"
  },
  // workers_dev MUST stay false. Access cannot protect a *.workers.dev hostname,
  // so if this were true the board would also answer, unauthenticated, at
  // wipboard.aayus-pok.workers.dev and walk straight around the Access policy.
  "workers_dev": false,
  "routes": [
    { "pattern": "wipboard.enamelvault.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "BOARD",
      "id": "9f69ce5adf464cb6b9e48761e07c3cdb"
    }
  ],
  // BOARD_TOKEN is a secret, set with `wrangler secret put BOARD_TOKEN`.
  // It must never appear here: this file is tracked.
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
